{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Finance API",
    "version": "0.0.5",
    "description": "Smart Finance uses a JSESSIONID cookie and CSRF protection.\nFirst GET /api/auth/csrf and retain its cookie. Send the returned token in\nX-CSRF-TOKEN for registration, login and logout. Registration creates an\naccount without signing in; log in separately and refresh CSRF after login.\n"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "检查应用是否能够响应",
        "description": "返回 status=UP，确认 HTTP 服务正在响应；不检查数据库或其他外部依赖。",
        "responses": {
          "200": {
            "description": "Application is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "getCsrf",
        "summary": "获取当前会话的 CSRF 令牌",
        "description": "返回令牌及其请求头和参数名称；同时保留会话 Cookie，登录成功后重新获取令牌。",
        "responses": {
          "200": {
            "description": "CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "register",
        "summary": "注册账号",
        "description": "创建账号，不自动登录。displayName 为独立的姓名或昵称，1–80 个字符；username 为唯一登录账号，\n支持普通用户名、中文用户名、数字账号或邮箱形式，1–64 个非空白字符，不要求邮箱格式。\nemail 和 phone 为可选联系资料，未填写时保存为空字符串，联系邮箱不是额外登录账号。\ncurrency、timezone、monthlyBudget、budgetStartDay 保存记账偏好；金额以十进制字符串传递，\n不表示现有演示账目已开启预算计算或多币种换算。password 至少\n8 个字符、最多 72 个 UTF-8 字节，且不能全为空白；confirmPassword\n必须与 password 完全一致。密码仅以 BCrypt 哈希保存。\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "账号创建成功，返回用户名；之后需调用登录接口",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "用户名已被注册（USERNAME_TAKEN），不会覆盖原账号",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "login",
        "summary": "校验数据库账号并建立登录会话",
        "description": "使用用户名查询数据库，通过 BCrypt 校验密码并检查账号启用及逻辑删除状态。\n请求必须携带同一会话的 Cookie 和 CSRF 请求头。成功后轮换 JSESSIONID，\n返回用户名和身份，并保存服务端登录状态；浏览器需保留新 Cookie 并刷新 CSRF 令牌。\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; retain the rotated JSESSIONID cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "getCurrentUser",
        "summary": "查询当前登录用户",
        "description": "返回当前会话的用户名和数据库最新身份，不返回密码哈希；未登录、会话失效、账号禁用或逻辑删除时返回 401。",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "logout",
        "summary": "退出登录并销毁会话",
        "description": "要求有效会话和当前 CSRF 令牌；销毁服务端会话并清除认证信息，刷新页面后仍需重新登录。",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "responses": {
          "204": {
            "description": "Session invalidated"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "operationId": "listVisibleUsers",
        "summary": "查询当前用户可见的用户一览",
        "description": "使用当前会话的数据库身份决定查询范围。管理员查看全部未删除账号，一般用户仅查看自己。\n返回主键、用户名、身份、启用状态、创建及修改审计信息和删除标记，不返回密码或密码哈希。\n不接受指定其他用户的查询参数；被降级的管理员下一次请求即只返回自己的信息。\n",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前用户可见的用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserSummary"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "operationId": "listUsers",
        "summary": "管理员查询用户列表",
        "description": "仅 ADMIN 可访问；仅返回未删除账号的身份和启用状态，不返回密码或密码哈希。",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserSummary"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/admin/users/{id}/role": {
      "put": {
        "tags": [
          "Users"
        ],
        "operationId": "updateUserRole",
        "summary": "管理员修改用户身份",
        "description": "仅 ADMIN 可操作，要求 Session Cookie 和 CSRF 请求头。\n身份写入数据库，目标用户下一次请求即使用新权限。\n不允许将最后一个启用的管理员降级为一般用户。\n已删除用户按用户不存在处理；修改时间和实际操作者由后端写入，不接受客户端审计字段。\n",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改成功，返回最新用户身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSummary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "用户不存在（USER_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "不能降级最后一个启用的管理员（LAST_ADMIN）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ledger/options": {
      "get": {
        "tags": [
          "Ledger"
        ],
        "operationId": "getLedgerOptions",
        "summary": "获取本人账户、分类和记账偏好",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerOptions"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/accounts": {
      "post": {
        "tags": [
          "Ledger"
        ],
        "operationId": "createLedgerAccount",
        "summary": "新增本人账户",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerAccount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "ACCOUNT_DUPLICATE 同名同币种账户已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerAccountInput"
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": [
          "Ledger"
        ],
        "operationId": "listLedgerEntries",
        "summary": "按类型、日期闭区间和账户分页查看本人流水",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerEntryPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "本人账户不存在（包括其他人的账户）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "INCOME",
                "EXPENSE"
              ]
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "accountId",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Ledger"
        ],
        "operationId": "createLedgerEntry",
        "summary": "新增本人收入或支出，账户与类型分类必须对应",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerEntry"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "本人账户不存在（包括其他人的账户）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerEntryInput"
              }
            }
          }
        }
      }
    },
    "/api/transactions/import/inspect": {
      "post": {
        "tags": [
          "Ledger"
        ],
        "operationId": "ledgerImportInspect",
        "summary": "读取文件列名与样例",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerInspection"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "UTF-8 CSV（可含 BOM）、XLS 或 XLSX；5MB/500 行/30 列，首行为表头；Excel 首张工作表，不接受公式"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions/import/preview": {
      "post": {
        "tags": [
          "Ledger"
        ],
        "operationId": "ledgerImportPreview",
        "summary": "字段映射、逐行预览及重复与异常提示（不写入）",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerPreview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "mapping"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "UTF-8 CSV（可含 BOM）、XLS 或 XLSX；5MB/500 行/30 列，首行为表头；Excel 首张工作表，不接受公式"
                  },
                  "mapping": {
                    "type": "string",
                    "description": "LedgerMapping 的 JSON 字符串。账户名称只匹配本人账户，重名需 currency 列区分。日期 YYYY-MM-DD 或 YYYY/M/D；金额正数可有标准千分组；类型和分类接受代码/中日文。"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions/import": {
      "post": {
        "tags": [
          "Ledger"
        ],
        "operationId": "commitLedgerImport",
        "summary": "确认导入：重新验证全部记录，默认跳过重复，失败整批回滚",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerImportResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "本人账户不存在（包括其他人的账户）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerImportInput"
              }
            }
          }
        },
        "description": "相同账户、方向、金额、日期、分类、商家和备注视为重复；仅在本人未删除流水中比较。每批最多500条；前端明确排除预览错误行后提交有效行。创建/修改用户来自认证会话。"
      }
    },
    "/api/transactions/export": {
      "get": {
        "tags": [
          "Ledger"
        ],
        "operationId": "exportLedgerEntries",
        "summary": "导出本人筛选范围内全部流水，最多10000条（超限返回400）",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "CSV（UTF-8 BOM、公式转义）或 XLSX（文字单元格）；列 kind,amount,date,account,category,merchant,note,currency，可重新导入",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "本人账户不存在（包括其他人的账户）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "INCOME",
                "EXPENSE"
              ]
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "in": "query",
            "name": "accountId",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "format",
            "schema": {
              "type": "string",
              "enum": [
                "csv",
                "xlsx"
              ],
              "default": "csv"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "parameters": {
      "CsrfHeader": {
        "name": "X-CSRF-TOKEN",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Missing, malformed or invalid input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid credentials or unauthenticated session",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Missing or invalid CSRF token or insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "ADMIN",
          "USER"
        ],
        "description": "ADMIN 为管理员，USER 为一般用户"
      },
      "RoleUpdateRequest": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "enabled",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "isDeleted",
          "displayName",
          "email",
          "phone",
          "currency",
          "timezone",
          "monthlyBudget",
          "budgetStartDay"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "enabled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "description": "数据库创建时间，ISO 本地日期时间格式，不包含时区偏移",
            "example": "2026-10-09T12:30:00.123456"
          },
          "createdBy": {
            "type": "string",
            "description": "创建用户名或 SYSTEM、LEGACY 标记"
          },
          "updatedAt": {
            "type": "string",
            "description": "数据库修改时间，ISO 本地日期时间格式，不包含时区偏移",
            "example": "2026-10-09T12:30:00.123456"
          },
          "updatedBy": {
            "type": "string",
            "description": "最后修改用户名或 SYSTEM、LEGACY 标记"
          },
          "isDeleted": {
            "type": "boolean",
            "description": "是否逻辑删除；用户一览只返回未删除账号，因此此字段为 false"
          },
          "displayName": {
            "type": "string",
            "description": "姓名或昵称，与登录账号独立，可以重名"
          },
          "email": {
            "type": "string",
            "description": "联系邮箱，未填写时为空字符串，不作为登录账号别名"
          },
          "phone": {
            "type": "string",
            "description": "联系手机号，未填写时为空字符串"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "pattern": "[A-Z]{3}",
            "description": "ISO 4217 记账币种，默认 JPY，不允许无货币用途的代码"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64,
            "description": "有效 IANA 时区，默认 Asia/Tokyo"
          },
          "monthlyBudget": {
            "type": "string",
            "pattern": "^$|^[0-9]{1,12}(\\.[0-9]{1,4})?$",
            "description": "可选月度预算，十进制金额字符串，最多 12 位整数；小数位不得超过所选币种精度，未设置为空字符串"
          },
          "budgetStartDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 28,
            "description": "每月预算周期起始日，默认 1，范围 1–28"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "username",
          "password",
          "confirmPassword",
          "displayName"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S+",
            "description": "唯一登录账号，支持普通用户名、中文用户名、数字或邮箱形式，不允许包含空白"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "[^\\x00-\\x1F\\x7F]+",
            "description": "姓名或昵称，不能为空或全为空白，不能包含控制字符，可以重名"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^$|^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "description": "可选联系邮箱；未填写时可省略或传空字符串，不作为额外登录账号"
          },
          "phone": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^$|^\\+?[0-9][0-9 ()-]{5,29}[0-9]$",
            "description": "可选联系手机号；支持国际区号、空白、括号和连字符，填写时为 7–32 个字符"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 72,
            "description": "至少 8 个字符，最多 72 个 UTF-8 字节，不能全为空白"
          },
          "confirmPassword": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 72,
            "description": "必须与 password 完全一致"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "pattern": "[A-Z]{3}",
            "description": "ISO 4217 记账币种，默认 JPY，不允许无货币用途的代码"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64,
            "description": "有效 IANA 时区，默认 Asia/Tokyo"
          },
          "monthlyBudget": {
            "type": "string",
            "pattern": "^$|^[0-9]{1,12}(\\.[0-9]{1,4})?$",
            "description": "可选月度预算，十进制金额字符串，最多 12 位整数；小数位不得超过所选币种精度，未设置为空字符串"
          },
          "budgetStartDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 28,
            "description": "每月预算周期起始日，默认 1，范围 1–28"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S+"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 72
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "username",
          "role"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "required": [
          "token",
          "headerName",
          "parameterName"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          },
          "parameterName": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LedgerAccount": {
        "type": "object",
        "required": [
          "id",
          "name",
          "currency",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "createdAt": {
            "type": "string",
            "description": "数据库创建时间（服务器时间，无时区后缀）"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "description": "数据库最后修改时间（服务器时间，无时区后缀）"
          },
          "updatedBy": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean",
            "description": "是否逻辑删除；当前查询只返回 false"
          }
        }
      },
      "LedgerAccountInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "省略时采用用户默认币种"
          }
        }
      },
      "LedgerEntryInput": {
        "type": "object",
        "required": [
          "accountId",
          "kind",
          "amount",
          "date",
          "category"
        ],
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "INCOME",
              "EXPENSE"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,4})?$",
            "description": "正数十进制字符串，不超过账户币种最小单位精度；禁止舍入"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "category": {
            "type": "string",
            "enum": [
              "SALARY",
              "BONUS",
              "PART_TIME",
              "INVESTMENT",
              "INTEREST",
              "GIFT",
              "OTHER_INCOME",
              "FOOD",
              "SHOPPING",
              "TRANSPORT",
              "HOUSING",
              "ENTERTAINMENT",
              "MEDICAL",
              "OTHER_EXPENSE"
            ]
          },
          "merchant": {
            "type": "string",
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "LedgerEntry": {
        "type": "object",
        "required": [
          "id",
          "accountId",
          "kind",
          "amount",
          "date",
          "category",
          "merchant",
          "note",
          "currency",
          "accountName",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "INCOME",
              "EXPENSE"
            ]
          },
          "amount": {
            "type": "string",
            "description": "数据库金额的十进制字符串，可能含四位小数末尾零"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "category": {
            "type": "string",
            "enum": [
              "SALARY",
              "BONUS",
              "PART_TIME",
              "INVESTMENT",
              "INTEREST",
              "GIFT",
              "OTHER_INCOME",
              "FOOD",
              "SHOPPING",
              "TRANSPORT",
              "HOUSING",
              "ENTERTAINMENT",
              "MEDICAL",
              "OTHER_EXPENSE"
            ]
          },
          "merchant": {
            "type": "string",
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          },
          "currency": {
            "type": "string"
          },
          "accountName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "description": "数据库创建时间（服务器时间，无时区后缀）"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "description": "数据库最后修改时间（服务器时间，无时区后缀）"
          },
          "updatedBy": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean",
            "description": "是否逻辑删除；当前查询只返回 false"
          }
        }
      },
      "LedgerEntryPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerEntry"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "LedgerOptions": {
        "type": "object",
        "required": [
          "accounts",
          "categories",
          "currency",
          "timezone",
          "today"
        ],
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerAccount"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "kind",
                "name"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "currency": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "today": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "LedgerMapping": {
        "type": "object",
        "required": [
          "columns"
        ],
        "properties": {
          "columns": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            },
            "description": "零起始列索引。允许 amount/date/kind/account/category/merchant/note/currency；amount、date 必须映射。"
          },
          "defaultKind": {
            "type": "string",
            "enum": [
              "INCOME",
              "EXPENSE"
            ]
          },
          "defaultAccountId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "defaultCategory": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "LedgerInspection": {
        "type": "object",
        "required": [
          "headers",
          "sampleRows",
          "totalRows"
        ],
        "properties": {
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sampleRows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "totalRows": {
            "type": "integer",
            "maximum": 500
          }
        }
      },
      "LedgerPreviewRow": {
        "type": "object",
        "required": [
          "rowNumber",
          "entry",
          "duplicate",
          "errors"
        ],
        "properties": {
          "rowNumber": {
            "type": "integer",
            "description": "CSV 非空记录号或 Excel 原始行号，含标题行"
          },
          "entry": {
            "$ref": "#/components/schemas/LedgerEntryInput",
            "nullable": true
          },
          "duplicate": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LedgerPreview": {
        "type": "object",
        "required": [
          "rows",
          "valid",
          "duplicates",
          "invalid"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerPreviewRow"
            }
          },
          "valid": {
            "type": "integer",
            "description": "没有错误的行数，含重复行"
          },
          "duplicates": {
            "type": "integer"
          },
          "invalid": {
            "type": "integer"
          }
        }
      },
      "LedgerImportInput": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerEntryInput"
            },
            "minItems": 1,
            "maxItems": 500
          },
          "skipDuplicates": {
            "type": "boolean",
            "default": true,
            "nullable": true,
            "description": "省略/null/true 默认跳过数据库及本批次重复；false 明确允许重复"
          }
        }
      },
      "LedgerImportResult": {
        "type": "object",
        "required": [
          "imported",
          "skipped"
        ],
        "properties": {
          "imported": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          }
        }
      }
    }
  }
}
